DATABASE_URL="postgresql://everafter:everafter_dev_password@localhost:5433/everafter"

# App
APP_URL="http://localhost:3000"

# Secret used to sign session tokens and signed image URLs (generate a long random string in production)
AUTH_SECRET="dev-only-secret-3f9c8a2e71b64d0c9e5f1a7b2c8d4e6f0a1b2c3d4e5f6a7b"

# Object storage: "local" (dev) or "s3"
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# S3-compatible storage (used when STORAGE_DRIVER="s3")
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Uploads
UPLOAD_MAX_BYTES="10485760"

# Stripe (billing-ready, not yet enabled)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (email-ready, not yet enabled)
RESEND_API_KEY=""
EMAIL_FROM="EverAfter <hello@everafter.example>"
